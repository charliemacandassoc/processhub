# ── Azure Entra ID ─────────────────────────────────────────────────────────────
# Register an App in Azure Portal > Entra ID > App Registrations
# Set redirect URIs: http://localhost:5173 (dev), https://<your-domain> (prod)
# Add app role: ProcessAdmin (value: ProcessAdmin)
VITE_ENTRA_CLIENT_ID=<app-registration-client-id>
VITE_ENTRA_TENANT_ID=<your-tenant-id>

# Backend (same values — duplicated for clarity)
ENTRA_CLIENT_ID=<app-registration-client-id>
ENTRA_TENANT_ID=<your-tenant-id>

# ── White-label branding ────────────────────────────────────────────────────────
VITE_APP_NAME=Process Hub
VITE_TENANT_NAME=Charlie Mac
VITE_PRIMARY_COLOR=#0078d4
VITE_LOGO_URL=https://www.charlie-mac.com/wp-content/uploads/2022/10/Charlie-Mac-logo-tight-cropped-transparent-background-small.png

# ── Social links (optional — defaults to Charlie Mac URLs) ─────────────────────
VITE_GITHUB_URL=https://github.com/charliemacandassoc/processhub
VITE_FACEBOOK_URL=https://facebook.com/charliemacandassoc
VITE_LINKEDIN_URL=https://www.linkedin.com/company/charlie-mac-and-associates

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=https://processhub.charlie-mac.com
